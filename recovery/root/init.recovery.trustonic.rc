# Start Daemon (Registry directories should already be present)
service mobicore /vendor/bin/mcDriverDaemon --P1 /mnt/vendor/persist/mcRegistry \
    -r /vendor/app/mcRegistry/020f0000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/030b0000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/05120000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/07150000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/07170000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/09070000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/09080000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/09190000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/07060000000000000000000000007169.drbin \
    -r /vendor/app/mcRegistry/07010000000000000000000000000000.drbin
    user root
    group root
    disabled
    seclabel u:r:recovery:s0
    priority -20

# t-Drv naming (OPPO A31 Verified Blobs)
# 020f0000... : utils
# 030b0000... : spi
# 05120000... : sec
# 07150000... : A31 specific trustlet
# 09070000... : A31 specific trustlet

on init
    # Create mountpoint for /mnt/vendor/persist partition
    mkdir /mnt/vendor/persist 0771 system system

on post-fs
    chown system system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist

    # Restorecon to set correct SEPolicy label for persist
    restorecon /mnt/vendor/persist

    # Create mcRegistry in persist to store failure records
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system

    write /proc/bootprof "MOBICORE: Starting mcDriverDaemon"
    start mobicore

on post-fs-data
    # Create key_provisioning directory for proper encryption policy
    mkdir /data/vendor/key_provisioning 0771 system system

# Normal mode, File-Based Encryption (FBE) - Required for A31 Decryption
on property:ro.crypto.type=file
    write /proc/bootprof "MOBICORE: create /data/vendor/mcRegistry ++ (FBE encrypted)"
    mkdir /data/vendor/mcRegistry 0775 system system
    write /proc/bootprof "MOBICORE: create /data/vendor/mcRegistry -- (FBE encrypted)"

# For META/FACTORY mode
on property:ro.crypto.state=unencrypted
    mkdir /data/vendor/mcRegistry 0775 system system
