# mount point    device                                                         flags
/system_image    /dev/block/platform/bootdevice/by-name/system                  flags=backup=1;flashimg=1;display="System Image"
/vendor_image    /dev/block/platform/bootdevice/by-name/vendor                  flags=backup=1;flashimg=1;display="Vendor Image"
/boot_para       /dev/block/platform/bootdevice/by-name/boot_para               flags=display="Boot Para";backup=1
/dtbo            /dev/block/platform/bootdevice/by-name/dtbo                    flags=display="DTBO";backup=1;flashimg=1
/odmdtbo         /dev/block/platform/bootdevice/by-name/odmdtbo                 flags=display="ODM DTBO";backup=1
/para            /dev/block/platform/bootdevice/by-name/para                    flags=display="Para";backup=1

# Storage
/external_sd     /dev/block/mmcblk1p1    /dev/block/mmcblk1                     flags=display="Micro SD card";storage;wipeingui;removable
/usb_otg         /dev/block/sda1         /dev/block/sda                         flags=display="USB-OTG";storage;removable;wipeingui

# Extra Backup
/nvram           /dev/block/platform/bootdevice/by-name/nvram                  flags=display="NVRAM";backup=1;flashimg=1
/nvdata          /dev/block/platform/bootdevice/by-name/nvdata                 flags=display="NVDATA";backup=1;subpartitionof=/nvram
/nvcfg           /dev/block/platform/bootdevice/by-name/nvcfg                  flags=display="NVCFG";backup=1;subpartitionof=/nvram
