#
# system.prop for Oppo A31 (OP4C7D)
#

# Platform & Hardware
ro.board.platform=mt6765
ro.hardware=mt6765
ro.mediatek.platform=MT6765
ro.vendor.mediatek.platform=MT6765
ro.hardware.kmsetkey=trustonic
ro.vendor.mtk_trustonic_tee_support=1

# Display / UI
ro.sf.lcd_density=320
ro.sf.hwrotation=0
ro.opengles.version=196610
debug.sf.disable_backpressure=1

# USB / ADB Initialization
sys.usb.controller=musb-hdrc
ro.usb.controller=musb-hdrc
persist.sys.usb.config=adb
ro.service.adb.root=1
